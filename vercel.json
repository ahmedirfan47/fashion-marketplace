{
    "crons": [
        {
            "path": "/api/cron/generate-payouts",
            "schedule": "0 0 1 * *"
        }
    ],
    "services": {
        "web": {
            "root": "apps/web",
            "framework": "nextjs",
            "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
            "buildCommand": "cd ../.. && pnpm --filter web build"
        },
        "billing": {
            "root": "services/billing"
        },
        "feed-ingestion": {
            "root": "services/feed-ingestion"
        },
        "shopify-sync": {
            "root": "services/shopify-sync"
        },
        "woocommerce-sync": {
            "root": "services/woocommerce-sync"
        }
    },
    "rewrites": [
        {
            "source": "/api/woocommerce-sync(/.*)?",
            "destination": {
                "type": "service",
                "service": "woocommerce-sync"
            }
        },
        {
            "source": "/api/feed-ingestion(/.*)?",
            "destination": {
                "type": "service",
                "service": "feed-ingestion"
            }
        },
        {
            "source": "/api/shopify-sync(/.*)?",
            "destination": {
                "type": "service",
                "service": "shopify-sync"
            }
        },
        {
            "source": "/api/billing(/.*)?",
            "destination": {
                "type": "service",
                "service": "billing"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "web"
            }
        }
    ]
}